PORT=3700
HOST=0.0.0.0

# path to the shared beatmap volume (same as other services)
BEATMAPS_PATH=/srv/root/.data/osu

# source for downloading .osu files
OSU_MIRROR_URL=https://old.ppy.sh/osu

# osu! v1 API key — if set, metadata goes to old.ppy.sh; if empty, uses MIRROR_ENDPOINT
# osu! **API key** from https://osu.ppy.sh/home/account/edit#api -- this is what
# the official api/v2 mirror uses as `Authorization: Bearer <key>`. It is NOT an
# OAuth token; osu!api v2 offers no OAuth option. The legacy endpoints that did
# accept OAuth user tokens (osu-web/osu-mapfile.php) are dead.
OSU_API_KEY=

# Cloudflare R2 — leave R2_BUCKET empty or "none" to disable
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

USE_MIRROR_ONLY=false

OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=